# Copy this file to mobile_node/keystore.properties (gitignored) and fill it in.
#
# Create the key ONCE, then back the .jks up somewhere safe (and keep the passwords):
#
#   keytool -genkeypair -v -keystore imu-release.jks -alias imu \
#           -keyalg RSA -keysize 4096 -validity 36500
#
# storeFile is relative to mobile_node/ unless it is an absolute path.
# Environment variables IMU_KEYSTORE_FILE, IMU_KEYSTORE_PASSWORD, IMU_KEY_ALIAS and
# IMU_KEY_PASSWORD are used when a key is absent here (handy for a one-off build).
storeFile=imu-release.jks
storePassword=change-me
keyAlias=imu
keyPassword=change-me