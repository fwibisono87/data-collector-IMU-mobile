{
  "$defs": {
    "AckMsg": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "req_id": {
          "title": "Req Id",
          "type": "string"
        },
        "type": {
          "const": "ack",
          "default": "ack",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "req_id",
        "ok"
      ],
      "title": "AckMsg",
      "type": "object"
    },
    "CalibrationState": {
      "properties": {
        "active_ref_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Ref Id"
        }
      },
      "required": [
        "active_ref_id"
      ],
      "title": "CalibrationState",
      "type": "object"
    },
    "Camera": {
      "description": "One selected camera slot (cam1..cam5).",
      "properties": {
        "cam_id": {
          "title": "Cam Id",
          "type": "string"
        },
        "device_key": {
          "title": "Device Key",
          "type": "string"
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drift"
            },
            {
              "type": "null"
            }
          ]
        },
        "dropped_frames": {
          "title": "Dropped Frames",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Height"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "recording": {
          "title": "Recording",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "opening",
            "live",
            "lost",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Width"
        }
      },
      "required": [
        "cam_id",
        "device_key",
        "label",
        "state",
        "recording",
        "width",
        "height",
        "fps",
        "dropped_frames",
        "error",
        "drift"
      ],
      "title": "Camera",
      "type": "object"
    },
    "CameraDevice": {
      "description": "A device the camera backend can open.",
      "properties": {
        "backend": {
          "enum": [
            "dshow",
            "v4l2",
            "fake"
          ],
          "title": "Backend",
          "type": "string"
        },
        "device_key": {
          "title": "Device Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "device_key",
        "label",
        "backend"
      ],
      "title": "CameraDevice",
      "type": "object"
    },
    "CameraSelectionItem": {
      "description": "One selected device. ``cam_id`` is optional: slots are assigned in list order.",
      "properties": {
        "cam_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cam Id"
        },
        "device_key": {
          "title": "Device Key",
          "type": "string"
        }
      },
      "required": [
        "device_key"
      ],
      "title": "CameraSelectionItem",
      "type": "object"
    },
    "CameraSelectionRequest": {
      "properties": {
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraSelectionItem"
          },
          "maxItems": 5,
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "cameras"
      ],
      "title": "CameraSelectionRequest",
      "type": "object"
    },
    "CameraSelectionResponse": {
      "properties": {
        "cameras": {
          "items": {
            "$ref": "#/$defs/Camera"
          },
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "cameras"
      ],
      "title": "CameraSelectionResponse",
      "type": "object"
    },
    "ClientMessage": {
      "discriminator": {
        "mapping": {
          "calibration.unwatch": "#/$defs/UnwatchMsg",
          "calibration.watch": "#/$defs/WatchMsg",
          "ping": "#/$defs/PingMsg"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WatchMsg"
        },
        {
          "$ref": "#/$defs/UnwatchMsg"
        },
        {
          "$ref": "#/$defs/PingMsg"
        }
      ]
    },
    "CompareCamera": {
      "description": "A Drift verdict attributed to one camera.",
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "integer"
        },
        "cam_id": {
          "title": "Cam Id",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "device_key": {
          "title": "Device Key",
          "type": "string"
        },
        "dx_px": {
          "title": "Dx Px",
          "type": "number"
        },
        "dy_px": {
          "title": "Dy Px",
          "type": "number"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "shift_pct": {
          "title": "Shift Pct",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "OK",
            "CHECK",
            "MOVED",
            "NO_SIGNAL",
            "MISSING",
            "RESOLUTION_CHANGED"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "dx_px",
        "dy_px",
        "shift_pct",
        "score",
        "confidence",
        "at_ms",
        "device_key",
        "cam_id"
      ],
      "title": "CompareCamera",
      "type": "object"
    },
    "CompareResult": {
      "description": "Result of ``GET /api/calibration/compare`` and the ``calibration.drift`` message.",
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "integer"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/CompareCamera"
          },
          "title": "Cameras",
          "type": "array"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "at_ms",
        "cameras"
      ],
      "title": "CompareResult",
      "type": "object"
    },
    "ConsolidationStatus": {
      "description": "Is the session's consolidation current? (Done view's Consolidation row.)\n\n``state`` is the row: ``not_needed`` for a whole session, ``pending_phone_data``\nwhen late rows / rescue uploads are not merged yet, ``current`` otherwise.\n``can_consolidate`` is the ported ``canConsolidate`` from the old end-session modal\nand decides whether \"Consolidate now\" is offered.",
      "properties": {
        "can_consolidate": {
          "title": "Can Consolidate",
          "type": "boolean"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "late_pending": {
          "title": "Late Pending",
          "type": "boolean"
        },
        "late_rows": {
          "title": "Late Rows",
          "type": "integer"
        },
        "recovery_pending": {
          "title": "Recovery Pending",
          "type": "boolean"
        },
        "rescue_uploads": {
          "title": "Rescue Uploads",
          "type": "integer"
        },
        "state": {
          "enum": [
            "current",
            "pending_phone_data",
            "not_needed"
          ],
          "title": "State",
          "type": "string"
        },
        "uploads_in_progress": {
          "title": "Uploads In Progress",
          "type": "boolean"
        },
        "whole": {
          "title": "Whole",
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "detail",
        "can_consolidate",
        "whole",
        "late_pending",
        "recovery_pending",
        "uploads_in_progress",
        "rescue_uploads",
        "late_rows"
      ],
      "title": "ConsolidationStatus",
      "type": "object"
    },
    "DeviceList": {
      "properties": {
        "devices": {
          "items": {
            "$ref": "#/$defs/CameraDevice"
          },
          "title": "Devices",
          "type": "array"
        }
      },
      "required": [
        "devices"
      ],
      "title": "DeviceList",
      "type": "object"
    },
    "DiskInfo": {
      "properties": {
        "free_bytes": {
          "title": "Free Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "free_bytes"
      ],
      "title": "DiskInfo",
      "type": "object"
    },
    "Draft": {
      "description": "Server-side copy of the Setup form, so every browser shows the same values.",
      "properties": {
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "session_tag": {
          "title": "Session Tag",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "updated_at_ms": {
          "title": "Updated At Ms",
          "type": "integer"
        }
      },
      "required": [
        "subject",
        "session_tag",
        "operator",
        "updated_at_ms"
      ],
      "title": "Draft",
      "type": "object"
    },
    "DraftUpdate": {
      "description": "``PUT /api/session/draft``. ``None`` means \"keep the current value\".",
      "properties": {
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "session_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Tag"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "title": "DraftUpdate",
      "type": "object"
    },
    "Drift": {
      "description": "Result of the calibration comparison against the active reference.",
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "integer"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "dx_px": {
          "title": "Dx Px",
          "type": "number"
        },
        "dy_px": {
          "title": "Dy Px",
          "type": "number"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "shift_pct": {
          "title": "Shift Pct",
          "type": "number"
        },
        "verdict": {
          "enum": [
            "OK",
            "CHECK",
            "MOVED",
            "NO_SIGNAL",
            "MISSING",
            "RESOLUTION_CHANGED"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "dx_px",
        "dy_px",
        "shift_pct",
        "score",
        "confidence",
        "at_ms"
      ],
      "title": "Drift",
      "type": "object"
    },
    "DriftMsg": {
      "properties": {
        "data": {
          "$ref": "#/$defs/CompareResult"
        },
        "type": {
          "const": "calibration.drift",
          "default": "calibration.drift",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "DriftMsg",
      "type": "object"
    },
    "EmptyResponse": {
      "description": "The documented ``{}`` body of dismiss / open-folder / activate / deactivate.",
      "properties": {},
      "title": "EmptyResponse",
      "type": "object"
    },
    "ErrorBody": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FinalizeMsg": {
      "properties": {
        "data": {
          "$ref": "#/$defs/FinalizeProgress"
        },
        "type": {
          "const": "finalize",
          "default": "finalize",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "FinalizeMsg",
      "type": "object"
    },
    "FinalizeProgress": {
      "description": "Finalize progress for one session; also the payload of the ``finalize`` WS message.",
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/FinalizeStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "steps"
      ],
      "title": "FinalizeProgress",
      "type": "object"
    },
    "FinalizeStep": {
      "description": "One step of the finalize job. ``detail`` is human-readable error/extra text.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "ended_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At Ms"
        },
        "name": {
          "enum": [
            "close_writers",
            "cameras",
            "consolidate",
            "validate",
            "bundle",
            "package",
            "late_window"
          ],
          "title": "Name",
          "type": "string"
        },
        "started_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At Ms"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "started_at_ms",
        "ended_at_ms",
        "detail"
      ],
      "title": "FinalizeStep",
      "type": "object"
    },
    "Issue": {
      "description": "One actionable problem or warning. ``subject`` identifies what it is about\n(device_id, cam_id or a form field name).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "LabelRequest": {
      "properties": {
        "label_id": {
          "maximum": 50,
          "minimum": 0,
          "title": "Label Id",
          "type": "integer"
        }
      },
      "required": [
        "label_id"
      ],
      "title": "LabelRequest",
      "type": "object"
    },
    "LabelResponse": {
      "properties": {
        "label_id": {
          "title": "Label Id",
          "type": "integer"
        },
        "since_ms": {
          "title": "Since Ms",
          "type": "integer"
        }
      },
      "required": [
        "label_id",
        "since_ms"
      ],
      "title": "LabelResponse",
      "type": "object"
    },
    "LateRows": {
      "description": "Rows that arrived inside the late window for one device.",
      "properties": {
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        }
      },
      "required": [
        "device_id",
        "role",
        "rows"
      ],
      "title": "LateRows",
      "type": "object"
    },
    "LiveData": {
      "properties": {
        "phones": {
          "additionalProperties": {
            "$ref": "#/$defs/LiveSample"
          },
          "title": "Phones",
          "type": "object"
        },
        "t_ms": {
          "title": "T Ms",
          "type": "integer"
        }
      },
      "required": [
        "t_ms",
        "phones"
      ],
      "title": "LiveData",
      "type": "object"
    },
    "LiveMsg": {
      "properties": {
        "data": {
          "$ref": "#/$defs/LiveData"
        },
        "type": {
          "const": "live",
          "default": "live",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "LiveMsg",
      "type": "object"
    },
    "LiveSample": {
      "description": "Latest IMU sample of one phone. ``acc`` is in g, ``gyro`` in deg/s.",
      "properties": {
        "acc": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Acc",
          "type": "array"
        },
        "gyro": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Gyro",
          "type": "array"
        },
        "ts_ms": {
          "title": "Ts Ms",
          "type": "integer"
        }
      },
      "required": [
        "acc",
        "gyro",
        "ts_ms"
      ],
      "title": "LiveSample",
      "type": "object"
    },
    "Notice": {
      "description": "A server-side notice. Unresolved & undismissed notices are in the snapshot.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "created_at_ms": {
          "title": "Created At Ms",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        }
      },
      "required": [
        "id",
        "level",
        "code",
        "message",
        "session_id",
        "created_at_ms",
        "resolved"
      ],
      "title": "Notice",
      "type": "object"
    },
    "PackageResponse": {
      "properties": {
        "zip_path": {
          "title": "Zip Path",
          "type": "string"
        }
      },
      "required": [
        "zip_path"
      ],
      "title": "PackageResponse",
      "type": "object"
    },
    "Phone": {
      "description": "One connected phone and its health.",
      "properties": {
        "app_version": {
          "title": "App Version",
          "type": "string"
        },
        "buffering": {
          "title": "Buffering",
          "type": "boolean"
        },
        "device_id": {
          "title": "Device Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "offline_since_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offline Since Ms"
        },
        "online": {
          "title": "Online",
          "type": "boolean"
        },
        "packets": {
          "title": "Packets",
          "type": "integer"
        },
        "rate_hz": {
          "title": "Rate Hz",
          "type": "number"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "telemetry_age_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Telemetry Age Ms"
        },
        "true_hz_avg": {
          "title": "True Hz Avg",
          "type": "number"
        }
      },
      "required": [
        "device_id",
        "role",
        "model",
        "app_version",
        "online",
        "offline_since_ms",
        "rate_hz",
        "true_hz_avg",
        "packets",
        "telemetry_age_ms",
        "buffering"
      ],
      "title": "Phone",
      "type": "object"
    },
    "PingMsg": {
      "properties": {
        "req_id": {
          "title": "Req Id",
          "type": "string"
        },
        "type": {
          "const": "ping",
          "default": "ping",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "req_id"
      ],
      "title": "PingMsg",
      "type": "object"
    },
    "Readiness": {
      "description": "What START needs (blockers) and what it merely records (warnings).",
